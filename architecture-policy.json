  "forbidden_module_names": [
    "common",
    "helpers",
    "manager",
    "models",
    "repositories",
    "service",
    "services",
    "utils"
  ],
  "forbidden_delivery_tokens": [
    "acceptance",
    "b1",
    "b2",
    "b5",
    "b6",
    "phase2",
    "poc",
    "readiness"
  ],
  "frozen_hot_files": [
    {
      "path": "app/executors/claude_agent_worker.py",
      "max_lines": 3116,
      "owner": "execution",
      "reason": "Legacy Harness worker adapter must shrink into execution infrastructure instead of accumulating responsibilities."
    },
    {
      "path": "app/models.py",
      "max_lines": 2326,
      "owner": "platform-architecture",
      "reason": "Legacy global DTO bucket is frozen while contracts move to owning domains."
    },
    {
      "path": "app/routes/chat.py",
      "max_lines": 2684,
      "owner": "conversations",
      "reason": "Legacy Chat transport is frozen while admission and orchestration move behind domain APIs."
    },
    {
      "path": "app/runtime/sandbox/container_provider.py",
      "max_lines": 5927,
      "owner": "sandbox",
      "reason": "Legacy Sandbox provider aggregate is frozen while provider adapters and lifecycle policy are separated."
    },
    {
      "path": "app/worker.py",
      "max_lines": 3420,
      "owner": "execution",
      "reason": "Legacy worker orchestration is frozen while execution use cases and adapters are extracted."
    }
  ],
  "compatibility_facades": [],
  "migration_bridges": [
    {
      "source_path": "app/runtime/sandbox/container_provider.py",
      "target_module": "app.sandbox.infrastructure.workspace_transfer",
      "module_alias": "opensandbox_workspace_transfer",
      "symbols": [
        "_OPENSANDBOX_STAGE_MAX_DIRECTORIES",
        "_OPENSANDBOX_STAGE_MAX_FILES",
        "_OPENSANDBOX_STAGE_MAX_FILE_BYTES",
        "_OPENSANDBOX_STAGE_MAX_TOTAL_BYTES",
        "_OpenSandboxWorkspaceFile",
        "_WorkspaceDirectorySnapshot",
        "_WorkspaceFileSnapshot",
        "_assert_workspace_directory",
        "_authorized_staged_skill_names",
        "_build_opensandbox_workspace_manifest",
        "_directory_open_flags",
        "_directory_snapshot_from_stat",
        "_file_open_flags",
        "_open_workspace_directory_fd",
        "_open_workspace_file_fd",
        "_open_workspace_relative_parent_fd",
        "_read_stable_workspace_file",
        "_require_secure_workspace_transfer",
        "_safe_workspace_relative_path",
        "_secure_workspace_transfer_supported",
        "_stage_skills_required",
        "_staged_skill_mount_required",
        "_tool_policy_subject_authorized",
        "_workspace_file_snapshot",
        "_workspace_file_snapshot_from_stat"
      ],
      "owner": "sandbox",
      "reason": "The frozen OpenSandbox provider may expose these existing secure workspace-transfer primitives only as exact identity aliases while their implementation moves to the Sandbox infrastructure adapter.",
      "removal_condition": "After supported provider callers and tests use the Sandbox boundary, inventory external imports and remove this bridge in an authority-only change before deleting the container-provider aliases."
    }
  ],
  "definition_retirements": [],
  "legacy_api_cutovers": [],
  "production_registries": [
    {
      "path": "app/executors/registry.py",
      "factory_function": "_default_adapters",
      "allowed_keys": [
        "claude-agent-worker"
      ],
      "adapter_constructors": [
        {
          "module": "app.executors.claude_agent_worker",
          "name": "ClaudeAgentWorkerAdapter"
        }
      ],
      "selector_owners": [
        {
          "path": "app/skills/infrastructure/resolution_postgres.py",
          "symbol": "DEFAULT_RUN_EXECUTOR_TYPES"
        }
      ],
      "test_double_terms": [
        "deterministic",
        "dummy",
        "fake",
        "mock",
        "stub",
        "test"
      ],
      "owner": "execution",
      "reason": "Only explicitly supported production executor adapters may be selected at runtime."
    }
  ],
  "governed_symbols": [
    {
      "name": "OUTBOX_TARGET_ARTIFACT",
      "path": "app/persistence/object_deletions.py",
      "owner": "object_lifecycle",
      "reason": "Typed object-deletion target identities have one protocol owner."
    },
    {
      "name": "OUTBOX_TARGET_FILE",
      "path": "app/persistence/object_deletions.py",
      "owner": "object_lifecycle",
      "reason": "Typed object-deletion target identities have one protocol owner."
    }
  ],
  "exception_contract": {
    "path": ".architecture-governance-exception.json",
    "schema_version": "ai-platform.architecture-governance-exception.v1",
    "max_days": 30,
    "non_exemptible_codes": [
      "compatibility_import_forbidden",
      "cross_domain_internal_import",
      "facade_missing",
      "facade_wildcard_import",
      "governed_symbol_missing",
      "governed_symbol_owner",
      "kernel_product_import",
      "kernel_public_surface_forbidden",
      "layer_dependency_forbidden",
      "layer_external_dependency_forbidden",
      "legacy_api_cutover_contract",
      "legacy_api_cutover_retirement_required",
      "legacy_api_cutover_source_logic",
      "legacy_api_cutover_target_contract",
      "migration_bridge_import_contract",
      "migration_bridge_source_growth",
      "migration_bridge_source_logic",
      "migration_bridge_symbol_contract",
      "migration_bridge_target_contract",
      "platform_product_import",
      "registry_adapter_mismatch",
      "registry_duplicate_key",
      "registry_dynamic_selector",
      "registry_factory_contract",
      "registry_missing",
      "registry_missing_key",
      "registry_nonliteral_key",
      "registry_selector_mismatch",
      "registry_test_double",
      "registry_unknown_key"
    ],
    "owner": "platform-architecture",
    "reason": "Exceptions are candidate-bound migration evidence and cannot waive authority or security boundaries."
  }
}
