{
  "schema_version": "ai-platform.architecture-policy.v1",
  "owner": "platform-architecture",
  "reason": "Enforce the domain-first modular-monolith source contract for new backend changes without claiming that the legacy tree is already compliant.",
  "source_contract": "docs/architecture/source-code-architecture.md",
  "app_root": "app",
  "target_packages": [
    "agent_apps",
    "artifacts",
    "bootstrap",
    "compat",
    "context",
    "conversations",
    "execution",
    "files",
    "identity",
    "kernel",
    "mcp",
    "object_lifecycle",
    "platform",
    "runs",
    "sandbox",
    "skills",
    "streaming"
  ],
  "bounded_contexts": [
    "agent_apps",
    "artifacts",
    "context",
    "conversations",
    "execution",
    "files",
    "identity",
    "mcp",
    "object_lifecycle",
    "runs",
    "sandbox",
    "skills",
    "streaming"
  ],
  "layers": {
    "domain": {
      "owner": "platform-architecture",
      "reason": "Domain policy is framework-neutral and may depend only on its own domain and kernel primitives.",
      "may_import_own_layers": [
        "domain"
      ],
      "may_import_platform": false,
      "allow_third_party": false,
      "allowed_third_party_prefixes": []
    },
    "application": {
      "owner": "platform-architecture",
      "reason": "Application use cases own ports and orchestrate their own domain without concrete adapters.",
      "may_import_own_layers": [
        "application",
        "domain"
      ],
      "may_import_platform": false,
      "allow_third_party": false,
      "allowed_third_party_prefixes": []
    },
    "infrastructure": {
      "owner": "platform-architecture",
      "reason": "Infrastructure implements application-owned ports and may use technical platform clients.",
      "may_import_own_layers": [
        "application",
        "domain",
        "infrastructure"
      ],
      "may_import_platform": true,
      "allow_third_party": true,
      "allowed_third_party_prefixes": []
    },
    "transport": {
      "owner": "platform-architecture",
      "reason": "Transport translates protocols into application operations and never imports concrete infrastructure.",
      "may_import_own_layers": [
        "application",
        "domain",
        "transport"
      ],
      "may_import_platform": false,
      "allow_third_party": false,
      "allowed_third_party_prefixes": [
        "fastapi",
        "pydantic",
        "starlette"
      ]
    }
  },
  "public_cross_domain_modules": [
    "api",
    "events"
  ],
  "public_kernel_modules": [
    "memory_redaction",
    "runtime_debug"
  ],
  "approved_root_modules": [
    "app/__init__.py",
    "app/agent_profile_execution_validation.py",
    "app/auth.py",
    "app/auth_sessions.py",
    "app/capabilities.py",
    "app/capability_distribution.py",
    "app/capacity_baseline.py",
    "app/chat_session_projection.py",
    "app/context_builder.py",
    "app/context_manifest.py",
    "app/control_plane_contracts.py",
    "app/data_retention.py",
    "app/db.py",
    "app/department_directory.py",
    "app/error_taxonomy.py",
    "app/execution_boundary.py",
    "app/executor_reconciler.py",
    "app/file_parser_contracts.py",
    "app/file_preview_contracts.py",
    "app/intent_router.py",
    "app/main.py",
    "app/models.py",
    "app/office_execution_tier.py",
    "app/path_safety.py",
    "app/principal_authority.py",
    "app/product_events.py",
    "app/projection_redaction.py",
    "app/public_context_keys.py",
    "app/queue.py",
    "app/queue_payload_validation.py",
    "app/redis_client.py",
    "app/required_tool_contract.py",
    "app/run_admission_policy.py",
    "app/run_admission_terminalization.py",
    "app/run_control_readiness.py",
    "app/run_projection.py",
    "app/run_provenance.py",
    "app/schema_migrations.py",
    "app/session_actions.py",
    "app/settings.py",
    "app/storage.py",
    "app/tool_policy.py",
    "app/validation.py",
    "app/worker.py",
    "app/worker_main.py",
    "app/worker_principal_authority.py"
  ],
  "forbidden_module_names": [
    "common",
    "helpers",
    "manager",
    "models",
    "repositories",
    "service",
    "services",
    "utils"
  ],
  "forbidden_delivery_tokens": [
    "acceptance",
    "b1",
    "b2",
    "b5",
    "b6",
    "phase2",
    "poc",
    "readiness"
  ],
  "frozen_hot_files": [
    {
      "path": "app/auth_sessions.py",
      "max_lines": 2099,
      "owner": "identity",
      "reason": "Legacy browser session authority is frozen while it moves into the identity context."
    },
    {
      "path": "app/executors/claude_agent_worker.py",
      "max_lines": 3116,
      "owner": "execution",
      "reason": "Legacy Harness worker adapter must shrink into execution infrastructure instead of accumulating responsibilities."
    },
    {
      "path": "app/models.py",
      "max_lines": 2326,
      "owner": "platform-architecture",
      "reason": "Legacy global DTO bucket is frozen while contracts move to owning domains."
    },
    {
      "path": "app/queue.py",
      "max_lines": 2611,
      "owner": "execution",
      "reason": "Legacy queue orchestration is frozen while claim, lease and dispatch move behind execution APIs."
    },
    {
      "path": "app/routes/chat.py",
      "max_lines": 2684,
      "owner": "conversations",
      "reason": "Legacy Chat transport is frozen while admission and orchestration move behind domain APIs."
    },
    {
      "path": "app/routes/files.py",
      "max_lines": 2106,
      "owner": "files",
      "reason": "Legacy file transport is frozen while upload and preview routes move into the files context."
    },
    {
      "path": "app/routes/lambchat_compat.py",
      "max_lines": 2421,
      "owner": "conversations",
      "reason": "Current browser chat-session API in a legacy route module is frozen while TD-CONV-001 moves it into owning contexts."
    },
    {
      "path": "app/routes/runs.py",
      "max_lines": 2135,
      "owner": "runs",
      "reason": "Legacy run transport is frozen while run control and history routes move behind runs APIs."
    },
    {
      "path": "app/runtime/sandbox/container_provider.py",
      "max_lines": 5927,
      "owner": "sandbox",
      "reason": "Legacy Sandbox provider aggregate is frozen while provider adapters and lifecycle policy are separated."
    },
    {
      "path": "app/worker.py",
      "max_lines": 3420,
      "owner": "execution",
      "reason": "Legacy worker orchestration is frozen while execution use cases and adapters are extracted."
    }
  ],
  "production_registries": [
    {
      "path": "app/executors/registry.py",
      "factory_function": "_default_adapters",
      "allowed_keys": [
        "claude-agent-worker"
      ],
      "adapter_constructors": [
        {
          "module": "app.executors.claude_agent_worker",
          "name": "ClaudeAgentWorkerAdapter"
        }
      ],
      "selector_owners": [
        {
          "path": "app/skills/infrastructure/resolution_postgres.py",
          "symbol": "DEFAULT_RUN_EXECUTOR_TYPES"
        }
      ],
      "test_double_terms": [
        "deterministic",
        "dummy",
        "fake",
        "mock",
        "stub",
        "test"
      ],
      "owner": "execution",
      "reason": "Only explicitly supported production executor adapters may be selected at runtime."
    }
  ],
  "governed_symbols": [
    {
      "name": "OUTBOX_TARGET_ARTIFACT",
      "path": "app/persistence/object_deletions.py",
      "owner": "object_lifecycle",
      "reason": "Typed object-deletion target identities have one protocol owner."
    },
    {
      "name": "OUTBOX_TARGET_FILE",
      "path": "app/persistence/object_deletions.py",
      "owner": "object_lifecycle",
      "reason": "Typed object-deletion target identities have one protocol owner."
    }
  ],
  "exception_contract": {
    "path": ".architecture-governance-exception.json",
    "schema_version": "ai-platform.architecture-governance-exception.v1",
    "max_days": 30,
    "non_exemptible_codes": [
      "compatibility_import_forbidden",
      "cross_domain_internal_import",
      "governed_symbol_missing",
      "governed_symbol_owner",
      "kernel_product_import",
      "kernel_public_surface_forbidden",
      "layer_dependency_forbidden",
      "layer_external_dependency_forbidden",
      "platform_product_import",
      "registry_adapter_mismatch",
      "registry_duplicate_key",
      "registry_dynamic_selector",
      "registry_factory_contract",
      "registry_missing",
      "registry_missing_key",
      "registry_nonliteral_key",
      "registry_selector_mismatch",
      "registry_test_double",
      "registry_unknown_key"
    ],
    "owner": "platform-architecture",
    "reason": "Exceptions are candidate-bound migration evidence and cannot waive authority or security boundaries."
  }
}
