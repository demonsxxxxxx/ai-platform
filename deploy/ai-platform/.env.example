POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=54329
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_MAX_WAITING=100
DATABASE_POOL_CLOSE_TIMEOUT_SECONDS=5
DATASTORE_READINESS_TIMEOUT_SECONDS=2

REDIS_MAX_CONNECTIONS=64
REDIS_PORT=63799

MINIO_ROOT_USER=ai_platform_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9009
MINIO_CONSOLE_PORT=9010
S3_BUCKET=ai-platform-artifacts

AI_PLATFORM_API_PORT=8020
AI_PLATFORM_FRONTEND_PORT=18001
AI_PLATFORM_FRONTEND_IMAGE=
AI_PLATFORM_SOURCE_COMMIT=
AI_PLATFORM_API_UPSTREAM=http://api:8020
# Required external ProfileDrive connector reachable from the frontend container.
PROFILE_DRIVE_MCP_UPSTREAM=http://profile-drive-mcp:5201
# Optional until workspace staging is enabled. Production must use the connector's
# trusted HTTPS entrypoint; set both paths when that endpoint uses a private CA.
# The host path is a public CA certificate file, never a private key.
PROFILE_DRIVE_TRANSFER_UPSTREAM=
PROFILE_DRIVE_TRANSFER_CA_CERT_FILE=
PROFILE_DRIVE_TRANSFER_CA_CERT_HOST_FILE=
AI_PLATFORM_FRONTEND_MAX_BODY_SIZE=50m
AI_PLATFORM_FRONTEND_PROXY_READ_TIMEOUT=300s
AI_PLATFORM_FRONTEND_PROXY_SEND_TIMEOUT=300s
PUBLIC_SKILL_FILE_OVERLAY_MAX_BYTES=262144
QUEUE_TENANT_PROCESSING_LIMIT=0
QUEUE_USER_PROCESSING_LIMIT=0
QUEUE_LEASE_SCAN_LIMIT=50
QUEUE_INSIGHT_SCAN_LIMIT=500
QUEUE_LEASE_VISIBILITY_TIMEOUT_SECONDS=900
QUEUE_DEAD_LETTER_MAX_ENTRIES=1000
MAX_ACTIVE_WORKER_RUNS=10
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_TTL_SECONDS=60
WORKER_MAINTENANCE_INTERVAL_SECONDS=30
MEMORY_RETENTION_WORKER_CLEANUP_ENABLED=true
MEMORY_RETENTION_WORKER_CLEANUP_INTERVAL_SECONDS=300
MEMORY_RETENTION_WORKER_CLEANUP_LIMIT=200
DATA_RETENTION_WORKER_CLEANUP_ENABLED=true
DATA_RETENTION_WORKER_CLEANUP_INTERVAL_SECONDS=300
ARTIFACT_RETENTION_CLEANUP_LIMIT=50
OBJECT_DELETE_BATCH_LIMIT=50
OBJECT_DELETE_MAX_ATTEMPTS=5
OBJECT_DELETE_RETRY_BASE_SECONDS=60
OBJECT_DELETE_RETRY_CAP_SECONDS=3600
MEMORY_PHYSICAL_PURGE_LIMIT=50
MEMORY_PHYSICAL_PURGE_GRACE_DAYS=7
# Zero is the fail-safe default: these classes are retained until policy is approved.
RUN_EVENT_RETENTION_DAYS=0
CONTEXT_SNAPSHOT_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
MESSAGE_RETENTION_DAYS=0
FILE_RETENTION_DAYS=0
# Generate independent random secrets of at least 32 characters; preserve them across upgrades.
TRUSTED_PRINCIPAL_SECRET=
EXISTING_AUTH_BASE_URL=http://10.56.0.25:7263
EXISTING_USER_INFO_BASE_URL=http://10.56.0.25:5166
EXISTING_AUTH_TIMEOUT_SECONDS=15
# Must match the deployed non-GMPlimsAPI JWT signer; required and intentionally blank.
COMPANY_LOGIN_JWT_SECRET=
COMPANY_LOGIN_JWT_ISSUER=non-gmp-lims
COMPANY_LOGIN_JWT_AUDIENCE=web-ui
CORS_ALLOW_ORIGINS=https://ai-platform.example.internal
AI_SESSION_SECRET=
AI_SESSION_COOKIE_SECURE=true
AUTH_CONTEXT_COOKIE_SECURE=true
# POC only: allow browser-provided X-AI-User-* principal without gateway signing.
# Keep false for production; use an auth gateway to inject the signed principal.
FRONTEND_POC_AUTH_ENABLED=false

# MCP-only encrypted JWT/connection custody.
MCP_ENCRYPTION_KEYS_JSON=
MCP_ENCRYPTION_CURRENT_KEY_ID=current

# Platform-owned compatible model connection. The endpoint and API key are
# configured by an administrator in the Models page; only encryption and
# internal proxy secrets remain deployment-owned.
LLM_GATEWAY_PROVIDER=openai_compatible
MODEL_CONNECTION_ENCRYPTION_KEY=
MODEL_CONNECTION_ALLOWED_INTERNAL_HOSTS=
MODEL_PROXY_INTERNAL_TOKEN=
# These direct provider settings remain only for local non-OpenSandbox legacy
# execution. Released OpenSandbox packages omit them: configure every
# OpenSandbox upstream, credential and capacity in the administrator Models page.
# Model names/catalog below supply legacy selection before that connection is active.
OPENAI_BASE_URL=http://host.docker.internal:3002/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
ANTHROPIC_BASE_URL=http://host.docker.internal:3002
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-flash
CLAUDE_AGENT_MODEL=deepseek-v4-flash
DEFAULT_MODEL_ID=deepseek-v4-flash
MODEL_CATALOG_JSON=[{"id":"deepseek-v4-flash","label":"DeepSeek V4 Flash","provider":"new-api","max_input_tokens":128000},{"id":"deepseek-v4-pro","label":"DeepSeek V4 Pro","provider":"new-api","max_input_tokens":128000}]
# Worker-only SDK execution switch. API containers intentionally do not receive
# this execution toggle; they create runs and expose projections, while workers
# execute Claude Agent SDK Skill runs.
WORKER_CLAUDE_AGENT_SDK_ENABLED=true
CLAUDE_AGENT_SDK_TIMEOUT_SECONDS=0
CLAUDE_AGENT_SDK_MAX_TURNS=256
# Production SDK selection retains Bash while denying workspace mutation tools.
# Stack A release admission rejects weaker values before Compose materialization.
CLAUDE_AGENT_PERMISSION_MODE=dontAsk
CLAUDE_AGENT_ALLOWED_TOOLS=Read,Glob,LS,Bash
CLAUDE_AGENT_DISALLOWED_TOOLS=Write,Edit,NotebookEdit
CLAUDE_AGENT_WORKSPACE_ROOT=/tmp/ai-platform-agent-workspaces

# Do not put authenticated package indexes in deploy env files. The committed
# compose does not forward package-index variables as Docker build args because
# build args can persist in image layers.
AI_PLATFORM_IMAGE=
# Required only with docker-compose.sandbox.yml. Set to the numeric group owner
# reported for the controlled Docker socket on the target host.
DOCKER_SOCKET_GID=
SANDBOX_CONTAINER_PROVIDER=opensandbox
# Governed Docker egress admits only an immutable image reference ending in
# @sha256:<64 lowercase hex characters> or an exact local sha256 image ID. The
# release-authority command resolves the reviewed backend build to that ID; this
# local default is intentionally rejected if governed egress is enabled.
SANDBOX_EXECUTOR_IMAGE=ai-platform:local
SANDBOX_EXECUTOR_PUBLISHED_HOST=host.docker.internal
# Optional existing workspace data source, mounted read-only during explicit migration.
SANDBOX_WORKSPACE_MIGRATION_SOURCE=/data/ai-platform/runtime-workspaces
SANDBOX_WORKSPACE_ROOT=/data/opensandbox/workspaces/ai-platform
SANDBOX_CALLBACK_BASE_URL=http://api.sandbox.internal:8020
SANDBOX_CALLBACK_TOKEN=
SANDBOX_EGRESS_POLICY_ENABLED=false
# Required when governed Docker egress is enabled. Replace with an operator-held
# random value of at least 32 bytes; this placeholder intentionally fails closed.
SANDBOX_EGRESS_PROOF_SIGNING_KEY=replace_me_with_a_random_32_byte_minimum_value
# Non-secret identifier persisted in each proof. Rotate by changing this ID and
# key together; previous verification keys are read only for terminal history.
SANDBOX_EGRESS_PROOF_KEY_ID=current
# JSON map of previous key IDs to operator-held raw keys; leave empty unless
# retaining signed terminal history during a bounded rotation window.
SANDBOX_EGRESS_PROOF_PREVIOUS_KEYS_JSON=
SANDBOX_CALLBACK_HOST_GATEWAY=

# Direct OpenSandbox lifecycle server on a private host address. The selected
# package overlay sets the sandbox network; this URL is control-plane only.
OPENSANDBOX_BASE_URL=http://REQUIRED_PRIVATE_HOST_ADDRESS:8080
OPENSANDBOX_DOMAIN=
OPENSANDBOX_PROTOCOL=
OPENSANDBOX_API_KEY=
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_REQUEST_TIMEOUT_SECONDS=30
OPENSANDBOX_TIMEOUT_SECONDS=1800
# OpenSandbox requires immutable repository@sha256 plus its exact matching
# digest. Mutable tags and preloaded local image IDs are rejected.
OPENSANDBOX_EXECUTOR_IMAGE=
OPENSANDBOX_EXECUTOR_IMAGE_DIGEST=
# Production dedicated-egress topology; the internal-test package fixes bridge mode
# and omits these inputs from its packaged example.
OPENSANDBOX_EXPECTED_NETWORK_MODE=ai-platform-opensandbox-egress-v2
OPENSANDBOX_EGRESS_BRIDGE=br-osb-egress2
OPENSANDBOX_EGRESS_SUBNET=172.31.76.0/24
OPENSANDBOX_EGRESS_PROXY_IPV4=172.31.76.2
# Required only by the internal-test bridge package: bind the proxy on a host
# address reachable from the OpenSandbox bridge, never an untrusted public interface.
OPENSANDBOX_EGRESS_PROXY_BIND_ADDRESS=
OPENSANDBOX_EGRESS_PROXY_URL=
OPENSANDBOX_EXECUTOR_ENTRYPOINT=/app/docker-entrypoint.sh uvicorn
SANDBOX_RUNTIME_SUBJECT=direct-opensandbox
