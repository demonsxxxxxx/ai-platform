server {
    listen 8080;
    server_name _;
    access_log off;
    client_max_body_size 1m;
    client_body_timeout 10s;
    send_timeout 10s;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/api/ai/runtime/callbacks/(executor|context-retrieval|tool-permission)$ {
        limit_except POST {
            deny all;
        }
        proxy_pass ${AI_PLATFORM_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_pass_request_headers on;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    location ^~ /openai/ {
        limit_except POST {
            deny all;
        }
        proxy_pass ${AI_PLATFORM_API_UPSTREAM}/api/ai/internal/model-proxy/openai/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization "";
        proxy_set_header X-Api-Key "";
        proxy_set_header X-AI-Platform-Internal-Token ${MODEL_PROXY_INTERNAL_TOKEN};
        proxy_pass_request_headers on;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /anthropic/ {
        limit_except POST {
            deny all;
        }
        proxy_pass ${AI_PLATFORM_API_UPSTREAM}/api/ai/internal/model-proxy/anthropic/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization "";
        proxy_set_header X-Api-Key "";
        proxy_set_header X-AI-Platform-Internal-Token ${MODEL_PROXY_INTERNAL_TOKEN};
        proxy_pass_request_headers on;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        return 404;
    }
}
