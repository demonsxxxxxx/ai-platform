# Non-secret launch identity. Copy to /etc/ai-platform/opensandbox/server.env,
# replace every REQUIRED value, and set root:root mode 0600.
OPENSANDBOX_SERVER_IMAGE=REQUIRED_REGISTRY/opensandbox-server@sha256:REQUIRED_DIGEST
OPENSANDBOX_SERVER_IMAGE_DIGEST=sha256:REQUIRED_DIGEST
OPENSANDBOX_SERVER_UID=REQUIRED_DEDICATED_NONROOT_UID
OPENSANDBOX_SERVER_GID=REQUIRED_DEDICATED_NONROOT_GID
OPENSANDBOX_DOCKER_SOCKET_GID=REQUIRED_HOST_DOCKER_SOCKET_GID
# Dedicated private host address reachable by API/Worker but denied by sandbox policy.
OPENSANDBOX_LIFECYCLE_LISTEN_ADDRESS=REQUIRED_PRIVATE_NON_EGRESS_IPV4_ADDRESS
